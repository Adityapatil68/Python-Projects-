                           size_hint_y=None, height=dp(180))
        round_card(picker, BG2, 18)

        # Up buttons
        up = BoxLayout(size_hint_y=None, height=dp(44),
                       padding=[dp(60),dp(4)])
        for part in ['h','m']:
            b = Button(text='▲', font_size=sp(22),
                       background_color=(0,0,0,0), color=CYAN)
            b.bind(on_press=lambda _,p=part: self._chg(p,1))
            up.add_widget(b)
            if part=='h':
                up.add_widget(Widget(size_hint_x=None,width=dp(30)))
        picker.add_widget(up)

        t_row = BoxLayout(size_hint_y=None, height=dp(72),
                          padding=[dp(40),0])
        self.h_lbl = Label(text=f'{self.sel_hour:02d}',
                           font_size=sp(52), bold=True, color=WHITE)
        t_row.add_widget(self.h_lbl)
        t_row.add_widget(Label(text=':', font_size=sp(52), bold=True,
                               color=CYAN, size_hint_x=None, width=dp(24)))
        self.m_lbl = Label(text=f'{self.sel_min:02d}',
                           font_size=sp(52), bold=True, color=WHITE)
        t_row.add_widget(self.m_lbl)
        picker.add_widget(t_row)

        dn = BoxLayout(size_hint_y=None, height=dp(44),
                       padding=[dp(60),dp(4)])
        for part in ['h','m']:
            b = Button(text='▼', font_size=sp(22),
                       background_color=(0,0,0,0), color=CYAN)
            b.bind(on_press=lambda _,p=part: self._chg(p,-1))
            dn.add_widget(b)
            if part=='h':
                dn.add_widget(Widget(size_hint_x=None,width=dp(30)))
        picker.add_widget(dn)
        content.add_widget(picker)

        # Repeat / Sound
        opts_card = BoxLayout(orientation='vertical',
                              size_hint_y=None, height=dp(108),
                              spacing=0)
        round_card(opts_card, BG2, 18)
        for i,(title,sub,dest) in enumerate([
            ('Repeat','Mon – Fri','repeat'),
            ('Sound','Default Alarm',None),
        ]):
            row = BoxLayout(size_hint_y=None, height=dp(52),
                            padding=[dp(16),dp(10)])
            info = BoxLayout(orientation='vertical')
            info.add_widget(Label(text=title, font_size=sp(15),
                                  color=WHITE, halign='left',
                                  size_hint_y=None, height=dp(24)))
            info.add_widget(Label(text=sub, font_size=sp(11),
                                  color=GREY, halign='left',
                                  size_hint_y=None, height=dp(16)))
            row.add_widget(info)
            row.add_widget(Label(text='›', font_size=sp(20),
                                 color=GREY, size_hint=(None,1),
                                 width=dp(24)))
            if dest:
                btn = Button(text='',pos=row.pos, size=row.size,
                             background_color=(0,0,0,0))
                btn.bind(on_press=lambda _,d=dest:
                         setattr(self.manager,'current',d))
                row.add_widget(btn)
            opts_card.add_widget(row)
            if i==0: sep_line(opts_card)
        content.add_widget(opts_card)

        sv.add_widget(content)
        root.add_widget(sv)
        self.add_widget(root)

    def _chg(self, part, delta):
        if part=='h':
            self.sel_hour=(self.sel_hour+delta)%24
            self.h_lbl.text=f'{self.sel_hour:02d}'
        else:
            self.sel_min=(self.sel_min+delta)%60
            self.m_lbl.text=f'{self.sel_min:02d}'

    def _save(self, *_):
        t=f'{self.sel_hour:02d}:{self.sel_min:02d}'
        add_alarm(t,f'Alarm {t}',['Mon','Wed','Thu'],'')
        speak(f'Alarm set for {t}')
        self.manager.current='home'

