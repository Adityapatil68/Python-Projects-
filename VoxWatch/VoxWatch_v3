            self.gen_btn.background_color = PURPLE
            # Demo routine when no API key
            routine = [
                {'time':'06:30','task':'Light exercise','reason':'Low sleep detected'},
                {'time':'08:00','task':'Healthy breakfast','reason':'Boost energy'},
                {'time':'09:00','task':'DSA Practice','reason':'Peak focus time'},
                {'time':'13:00','task':'Lunch + 15min rest','reason':'Midday recharge'},
                {'time':'19:00','task':'Java + Projects','reason':'Evening productivity'},
                {'time':'22:00','task':'GitHub commit','reason':'Consistency streak'},
            ]
            self.status_lbl.text = '📋 Demo routine (add API key for AI)'

        global ai_routine
        ai_routine = routine
        self.routine_card.clear_widgets()

        self.routine_card.add_widget(Label(
            text='🤖 AI Generated Routine',
            font_size=sp(14), bold=True, color=CYAN,
            halign='left', size_hint_y=None, height=dp(30)))
        sep_line(self.routine_card)

        for i, item in enumerate(routine):
            row = BoxLayout(size_hint_y=None, height=dp(58),
                            padding=[dp(4),dp(6)], spacing=dp(8))
            # Time badge
            time_lbl = Label(
                text=item['time'], font_size=sp(15),
                bold=True, color=CYAN,
                size_hint=(None,1), width=dp(52))
            row.add_widget(time_lbl)
            # Task + reason
            info = BoxLayout(orientation='vertical')
            info.add_widget(Label(
                text=item['task'], font_size=sp(14),
                color=WHITE, halign='left',
                size_hint_y=None, height=dp(22)))
            info.add_widget(Label(
                text=item.get('reason',''),
                font_size=sp(11), color=GREY, halign='left',
                size_hint_y=None, height=dp(18)))
            row.add_widget(info)
            self.routine_card.add_widget(row)
            if i < len(routine)-1:
                sep_line(self.routine_card)

        self.gen_btn.text = '🔄  Regenerate'
        self.gen_btn.background_color = PURPLE
        self.add_btn.opacity = 1

    def _add_to_alarms(self, *_):
        for item in ai_routine:
            add_alarm(item['time'], item['task'],
                      ['Mon','Tue','Wed','Thu','Fri'],
                      item.get('reason',''))
        speak(f'Added {len(ai_routine)} AI alarms!')
        self.status_lbl.text = f'✅ {len(ai_routine)} alarms added!'
        self.manager.current = 'home'

