# ALARM CHECKER
# ══════════════════════════════════════════
class AlarmChecker:
    def __init__(self, trigger):
        self.ts=trigger
    def start(self):
        threading.Thread(target=self._loop,daemon=True).start()
    def _loop(self):
        while True:
            now=datetime.now().strftime('%H:%M')
            for a in alarms:
                if a['active'] and not a['triggered'] and a['time']==now:
                    a['triggered']=True
                    Clock.schedule_once(
                        lambda dt,al=a: self.ts.show_alarm(al),0)
            time.sleep(10)
            now2=datetime.now().strftime('%H:%M')
            for a in alarms:
                if a['triggered'] and a['time']!=now2:
                    a['triggered']=False

