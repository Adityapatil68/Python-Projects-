        for icon, val, lbl in [
            ('🚶', f"{health_data['steps']:,}", 'Steps'),
            ('❤️', f"{health_data['heart_rate']}", 'BPM'),
            ('😴', f"{health_data['sleep']}h", 'Sleep'),
            ('🔥', f"{health_data['calories']}", 'kcal'),
