# CLAUDE AI ENGINE
# ══════════════════════════════════════════
def claude_ai_routine(health, callback):
    """Ask Claude to generate smart routine based on health data"""
    def _call():
        prompt = f"""You are VoxWatch AI assistant.
Based on this health data:
- Steps today: {health['steps']}
- Heart rate: {health['heart_rate']} bpm
- Sleep last night: {health['sleep']} hours
- Calories burned: {health['calories']}

Generate a smart daily routine with 6 time slots.
Reply ONLY in this JSON format (no markdown):
{{"routine": [
  {{"time": "06:30", "task": "Morning exercise", "reason": "short reason"}},
  {{"time": "08:00", "task": "Breakfast", "reason": "short reason"}},
  {{"time": "09:00", "task": "DSA Practice", "reason": "short reason"}},
  {{"time": "13:00", "task": "Lunch + rest", "reason": "short reason"}},
  {{"time": "19:00", "task": "Java revision", "reason": "short reason"}},
  {{"time": "22:00", "task": "GitHub commit", "reason": "short reason"}}
]}}"""
        try:
            payload = json.dumps({
                "model": CLAUDE_MODEL,
                "max_tokens": 500,
                "messages": [{"role": "user", "content": prompt}]
            }).encode('utf-8')
            req = urllib.request.Request(
                CLAUDE_API_URL, data=payload,
                headers={
                    "Content-Type": "application/json",
                    "x-api-key": CLAUDE_API_KEY,
                    "anthropic-version": "2023-06-01"
                }, method="POST"
            )
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode())
                raw  = data['content'][0]['text'].strip()
                parsed = json.loads(raw)
                Clock.schedule_once(
                    lambda dt: callback(parsed['routine'], None), 0)
        except Exception as e:
            Clock.schedule_once(
                lambda dt: callback(None, str(e)), 0)
    threading.Thread(target=_call, daemon=True).start()

