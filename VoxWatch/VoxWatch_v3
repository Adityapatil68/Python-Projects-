            col = BoxLayout(orientation='vertical', padding=[dp(4),dp(8)])
            col.add_widget(Label(text=icon, font_size=sp(20),
                                 size_hint_y=None, height=dp(28)))
            col.add_widget(Label(text=val, font_size=sp(13), bold=True,
                                 color=CYAN, size_hint_y=None, height=dp(20)))
            col.add_widget(Label(text=lbl, font_size=sp(10),
                                 color=GREY, size_hint_y=None, height=dp(16)))
            health_card.add_widget(col)
        content.add_widget(health_card)

        # Alarms title row
        title_row = BoxLayout(size_hint_y=None, height=dp(32))
        title_row.add_widget(Label(
            text='ALARMS', font_size=sp(11), bold=True,
            color=GREY, halign='left'))
        self.alarm_count_lbl = Label(
            text='', font_size=sp(11), color=CYAN, halign='right')
        title_row.add_widget(self.alarm_count_lbl)
        content.add_widget(title_row)

