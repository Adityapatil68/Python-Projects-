            pos_hint={'center_x':0.5,'center_y':0.62})
        fl.add_widget(self.time_lbl)

        self.name_lbl=Label(
            text='Alarm', font_size=sp(20), color=CYAN,
            size_hint=(1,None), height=dp(30),
            pos_hint={'center_x':0.5,'center_y':0.52})
        fl.add_widget(self.name_lbl)

        # Routine card
        self.rt_card=BoxLayout(
            orientation='vertical',
            size_hint=(0.88,None), height=dp(160),
            pos_hint={'center_x':0.5,'center_y':0.33},
            padding=[dp(16),dp(12)], spacing=dp(4))
        round_card(self.rt_card, BG2, 18)
        self.rt_lbl=Label(
            text='', font_size=sp(13), color=SILVER,
            halign='left', valign='top',
            text_size=(dp(310),dp(130)))
        self.rt_card.add_widget(self.rt_lbl)
        fl.add_widget(self.rt_card)

        # Stop button
        stop=Button(
            text='⏹  Stop Alarm', font_size=sp(18),
            bold=True, size_hint=(0.82,None), height=dp(56),
            pos_hint={'center_x':0.5,'y':0.05},
            background_color=CORAL,
            border=(dp(28),)*4)
        stop.bind(on_press=lambda _: setattr(
            self.manager,'current','home'))
        fl.add_widget(stop)
        self.add_widget(fl)

    def show_alarm(self, alarm):
        self.time_lbl.text=alarm['time']
        self.name_lbl.text=alarm['label']
        items=[i.strip() for i in
               alarm.get('routine','').split('|') if i.strip()]
        self.rt_lbl.text='\n'.join(
            [f"  {i+1}.  {t}" for i,t in enumerate(items[:5])]
        ) if items else 'No routine — stay focused!'
        self.manager.current='trigger'
        msg=f"It's {alarm['time']}. {alarm['label']}. "
        if items:
            msg+="Routine: "+", then ".join(items[:3])
        speak(msg)

