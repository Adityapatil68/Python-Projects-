        self._refresh_alarms()

    def _tick(self, *_):
        now = datetime.now()
        self.dig_lbl.text  = now.strftime('%H:%M')
        self.date_lbl.text = now.strftime('%A, %d %B')

    def _refresh_alarms(self, *_):
        self.alarm_card.clear_widgets()
        active = sum(1 for a in alarms if a['active'])
        total  = len(alarms)
        self.alarm_count_lbl.text = f'{active}/{total} active'

        if not alarms:
            self.alarm_card.add_widget(Label(
                text='No alarms — tap ＋ to add!',
                font_size=sp(14), color=GREY,
                size_hint_y=None, height=dp(60),
                halign='center'))
            return

        for i, alarm in enumerate(alarms):
            row = BoxLayout(size_hint_y=None, height=dp(68),
                            padding=[dp(16),dp(10)])
            left = BoxLayout(orientation='vertical')
            tl = Label(text=alarm['time'], font_size=sp(26),
                       bold=True,
                       color=WHITE if alarm['active'] else GREY,
                       halign='left', size_hint_y=None, height=dp(34))
            tl.bind(size=lambda w,s: setattr(w,'text_size',s))
            left.add_widget(tl)
            sub = f"  {alarm['label']}  ·  " + (
                ', '.join(alarm['days']) if alarm['days'] else 'Once')
            sl = Label(text=sub, font_size=sp(11), color=GREY,
                       halign='left', size_hint_y=None, height=dp(18))
            sl.bind(size=lambda w,s: setattr(w,'text_size',s))
            left.add_widget(sl)
            row.add_widget(left)
            sw = Switch(active=alarm['active'],
                        size_hint=(None,None), size=(dp(56),dp(32)))
            sw.bind(active=lambda w,val,idx=i: self._tog(idx,val))
            row.add_widget(sw)
            self.alarm_card.add_widget(row)
            if i < len(alarms)-1:
                sep_line(self.alarm_card)

    def _tog(self, idx, val):
        if 0 <= idx < len(alarms):
            alarms[idx]['active'] = val

