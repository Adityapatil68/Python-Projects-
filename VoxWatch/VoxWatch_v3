def with_alpha(col, a):
    """Return an RGBA tuple from a color list/tuple and alpha value.

    Example: with_alpha(PURPLE, 0.15) -> (r,g,b,0.15)
    """
    try:
        return (col[0], col[1], col[2], float(a))
    except Exception:
        return (0, 0, 0, float(a))

# ── TTS
try:
    _tts = pyttsx3.init()
