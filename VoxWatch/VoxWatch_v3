class RepeatScreen(Screen):
    def __init__(self, **kw):
        super().__init__(**kw)
        self.selected={'Monday','Tuesday','Wednesday','Thursday','Friday'}
        self._build()

    def _build(self):
        root=BoxLayout(orientation='vertical')
        flat_bg(root, BG1)
        nav=BoxLayout(size_hint_y=None, height=dp(56),
                      padding=[dp(8),dp(10)])
        flat_bg(nav, BG1)
        back=Button(text='← Back', font_size=sp(15),
                    size_hint=(None,1), width=dp(90),
                    background_color=(0,0,0,0), color=CYAN)
        back.bind(on_press=lambda _: setattr(
            self.manager,'current','add_alarm'))
        nav.add_widget(back)
        nav.add_widget(Label(text='Repeat', font_size=sp(17),
                             bold=True, color=WHITE))
        nav.add_widget(Widget(size_hint_x=None, width=dp(90)))
        root.add_widget(nav)

        days_card=BoxLayout(orientation='vertical',
                            size_hint=(0.92,None), height=dp(392),
                            spacing=0)
        days_card.pos_hint={'center_x':0.5}
        round_card(days_card, BG2, 18)
        days=['Sunday','Monday','Tuesday','Wednesday',
              'Thursday','Friday','Saturday']
        for i,day in enumerate(days):
            row=BoxLayout(size_hint_y=None, height=dp(54),
                          padding=[dp(18),dp(10)])
            dl=Label(text=day, font_size=sp(16),
                     color=WHITE, halign='left')
            dl.bind(size=lambda w,s: setattr(w,'text_size',s))
            row.add_widget(dl)
            check=Label(text='✓' if day in self.selected else '',
                        font_size=sp(18), color=CYAN,
                        size_hint=(None,1), width=dp(30))
            row.add_widget(check)
            btn=Button(text='', background_color=(0,0,0,0))
            btn.bind(on_press=lambda w,dy=day,ch=check:
                     self._tog(dy,ch))
            row.add_widget(btn)
            days_card.add_widget(row)
            if i<len(days)-1: sep_line(days_card)

        root.add_widget(Widget(size_hint_y=None, height=dp(16)))
        root.add_widget(days_card)
        root.add_widget(Widget())
        self.add_widget(root)

    def _tog(self, day, ch):
        if day in self.selected:
            self.selected.discard(day); ch.text=''
        else:
            self.selected.add(day); ch.text='✓'

